# Copy to .env for local development. Every value shown is the default unless marked.
DATABASE_PATH=data/roadside.db
UPLOAD_DIR=data/uploads
# Demo mode (replay, no uploads) is the default; no keys are needed.
DEMO_MODE=true
# The public demo only (ADR 0011): startup then refuses DEMO_MODE=false and LLM_RECORD=true.
PUBLIC_DEPLOY=false
# What demo mode replays, and where LLM_RECORD writes. Missing = every AI turn is a key miss.
LLM_RECORDINGS_DIR=recordings
# Comma-separated, explicit origins only (never *).
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Live model (read only with DEMO_MODE=false) -------------------------------------------
# With DEMO_MODE=false, LLM_BASE_URL, LLM_API_KEY and LLM_MODEL are required: startup fails
# without them and never falls back to demo mode. Pick one preset and uncomment it.
LLM_PROVIDER=openai_compatible

# Preset A: Google Gemini through its OpenAI-compatible endpoint (free key from AI Studio).
# The free tier may use inputs to improve Google's products.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-3.8-flash

# Preset B: a local Ollama model (`ollama pull qwen3:8b`). Ollama ignores the key, but one
# must be set.
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
# Thinking models answer far faster with thinking off.
# LLM_REASONING_EFFORT=none

# Photos are sent to the model only when it can see them (later ticket).
LLM_VISION=false
LLM_MAX_IMAGES=3
LLM_TEMPERATURE=0.2
LLM_CONNECT_TIMEOUT_S=5
# Read timeout of one model call.
LLM_TIMEOUT_S=60
# The whole turn, retry and repair call included. Must stay under 100 s (the tunnel limit).
LLM_TURN_BUDGET_S=90
# Write each answer of the live model to LLM_RECORDINGS_DIR, for demo mode to replay.
# Needs DEMO_MODE=false.
LLM_RECORD=false

# --- Location context (ADR 0004). No call is made in demo mode. ---
# Coordinates go to this server, never to the model. Use a self-hosted instance if you prefer.
NOMINATIM_URL=https://nominatim.openstreetmap.org/
OSM_USER_AGENT=Roadside/0.1.0 (+https://github.com/eryk-poradecki/roadside)
NOMINATIM_TIMEOUT_S=3
# road_class becomes unknown when GPS accuracy or the matched road distance exceeds these.
LOCATION_MAX_GPS_ACCURACY_M=150
LOCATION_MAX_ROAD_DISTANCE_M=50

# --- Nearby places (ADR 0004). No call is made in demo mode. ---
# Comma-separated: the primary first, then the mirrors. OSM_USER_AGENT above is sent here too.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# One attempt, and the whole lookup with retries (must stay under 100 s, the tunnel limit).
OVERPASS_TIMEOUT_S=40
OVERPASS_BUDGET_S=75
OVERPASS_ATTEMPTS=3
# Wait before the second attempt; doubles after each failure.
OVERPASS_BACKOFF_S=2
