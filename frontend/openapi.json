    "/api/v1/incidents/{incident_id}/ai-turns": {
      "post": {
        "description": "Ask the assistant for the next turn of the AI answer and wait for it.\n\nSynchronous: the request holds until the turn is validated and stored, or has failed\n(nothing is stored then). One turn at a time per incident (409 `turn_in_progress`); the\nadvice closes the AI answer (409 `advice_exists`). Failures: 502 `provider_error` or\n`invalid_output`, 504 `timeout`. \"Try again\" repeats the same request.",
        "operationId": "take_ai_turn",
        "parameters": [
          {
            "in": "path",
            "name": "incident_id",
            "required": true,
            "schema": {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "title": "Incident Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AiTurnCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiTurnRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Take Ai Turn",
        "tags": [
          "ai"
        ]
      }
    },
